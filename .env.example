AGENT_MAX_ACTIONS_PER_REQUEST=2

DOCKER_IMAGE_NAME=netology-aiagnt:local
DOCKER_RUNTIME_VOLUME_NAME=netology-aiagnt-runtime

API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=60

CATALOG_SNAPSHOT_PATH=src/ai_agent/catalog/data/products.csv
CATALOG_DATABASE_PATH=runtime/catalog/products.db

MEMORY_DATABASE_PATH=runtime/memory/agent_memory.db
MEMORY_RETRIEVAL_LIMIT=10

RAG_RETRIEVAL_EMBEDDING_MODEL=intfloat/multilingual-e5-base
RAG_RETRIEVAL_VECTOR_STORE_PATH=runtime/rag/vector_store
RAG_RETRIEVAL_COLLECTION_NAME=store_knowledge
RAG_RETRIEVAL_SEARCH_TOP_K=5
RAG_RETRIEVAL_MIN_SCORE=0.80
RAG_RETRIEVAL_MAX_CONTEXT_TOKENS=1800
RAG_RETRIEVAL_CONTEXT_TOKENIZER_MODEL=text-embedding-3-small

RAG_PIPELINE_PATHS__INPUT=src/ai_agent/rag/knowledge_base/raw
RAG_PIPELINE_PATHS__PREPARED=runtime/rag/prepared
RAG_PIPELINE_PATHS__CHUNKS=runtime/rag/chunks
RAG_PIPELINE_PATHS__EMBEDDINGS=runtime/rag/embeddings
RAG_PIPELINE_PATHS__VECTOR_STORE=runtime/rag/vector_store
RAG_PIPELINE_CLEANING__REMOVE_EMPTY_DOCUMENTS=true
RAG_PIPELINE_NORMALIZATION__UNICODE_FORM=NFC
RAG_PIPELINE_DEDUPLICATION__EXACT=true
RAG_PIPELINE_DEDUPLICATION__NEAR_DUPLICATE=true
RAG_PIPELINE_DEDUPLICATION__SIMILARITY_THRESHOLD=0.65
RAG_PIPELINE_DEDUPLICATION__PERMUTATIONS_NUMBER=128
RAG_PIPELINE_CHUNKING__STRATEGY=sentence
RAG_PIPELINE_CHUNKING__CHUNK_SIZE=220
RAG_PIPELINE_CHUNKING__CHUNK_OVERLAP=50
RAG_PIPELINE_CHUNKING__TOKENIZER_MODEL=text-embedding-3-small
RAG_PIPELINE_EMBEDDING__MODEL=intfloat/multilingual-e5-base
RAG_PIPELINE_VECTOR_STORE__COLLECTION_NAME=store_knowledge
RAG_PIPELINE_VECTOR_STORE__RECREATE_COLLECTION=true
RAG_PIPELINE_VECTOR_STORE__STORE_TYPE=qdrant
RAG_PIPELINE_VECTOR_STORE__DISTANCE=cosine
RAG_PIPELINE_VECTOR_STORE__VECTORS_DIMENSIONS=768
RAG_PIPELINE_VECTOR_STORE__UPLOAD_BATCH_SIZE=100
RAG_PIPELINE_VECTOR_STORE__SEARCH_TOP_K=5
RAG_PIPELINE_VECTOR_STORE__SEARCH_TEST_QUERIES=3

HF_HOME=runtime/huggingface
